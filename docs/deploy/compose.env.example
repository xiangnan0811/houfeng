# Copy to docs/deploy/compose.env before running Docker Compose.
# compose.yaml pulls linnea7171/houfeng:latest; it does not build locally.
# Replace every password and secret before first boot.
# PostgreSQL data is stored under ./data/postgres/ by the root compose.yaml.
# Center application logs are stored in the houfeng_logs named Docker volume
# and are also available through docker compose logs houfeng.
# Sensitive values stay in this untracked env file. The tracked compose.yaml
# intentionally avoids password-like HOUFENG_DATABASE_URL, POSTGRES_PASSWORD,
# HOUFENG_INITIAL_PASSWORD, and HOUFENG_SESSION_HMAC_KEY assignment lines so
# repository secret scanners do not flag placeholder deployment configuration.

# PostgreSQL password used by both the db service and the center connection URL.
# Use URL-safe characters because the Houfeng container entrypoint assembles a
# postgres:// connection URL from this value at runtime.
POSTGRES_PASSWORD=replace-me-with-a-real-database-password

# Initial admin user seed. Used only when the users table is empty.
HOUFENG_INITIAL_USERNAME=admin
HOUFENG_INITIAL_PASSWORD=replace-me-with-a-real-admin-password

# Required center session HMAC secret. Use at least 32 random bytes; keep it
# stable across restarts. Rotating it invalidates existing browser sessions.
HOUFENG_SESSION_HMAC_KEY=replace-me-with-32-plus-random-bytes

# Optional host port override. Default publishes Houfeng on 127.0.0.1:16001.
# HOUFENG_HOST_PORT=16001

# Optional production hardening. Set this to true when HOUFENG_DATABASE_URL
# points at an external PostgreSQL server; the URL must then include
# sslmode=require, sslmode=verify-ca, or sslmode=verify-full.
# HOUFENG_DATABASE_REQUIRE_TLS=true

# Optional password hashing cost tuning. Default is Go bcrypt's DefaultCost
# (currently 10). Benchmark login/change-password latency on target hardware
# before raising it.
# HOUFENG_PASSWORD_BCRYPT_COST=12

# Optional for first login. Required before generating one-command agent install
# commands. Must be the externally reachable http(s) URL for browsers and agents,
# without query or fragment, for example https://center.example.com.
HOUFENG_PUBLIC_BASE_URL=
