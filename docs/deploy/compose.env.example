# Copy this downloaded release asset to .env beside compose.yaml.
# The release workflow replaces the empty HOUFENG_IMAGE value with the exact
# immutable release tag. Never commit the completed .env file.

# Must change
# Existing Docker network already joined by Nginx Proxy Manager.
HOUFENG_PROXY_NETWORK=
# External browser/agent origin. Production deployments use HTTPS and no path,
# query, or fragment, for example https://center.example.com.
HOUFENG_PUBLIC_BASE_URL=

# PostgreSQL bootstrap and three distinct constrained direct-login roles.
# Generate a fresh value for every secret below with: openssl rand -hex 32
# Run it separately for every blank. Never reuse one value for another secret.
# Paste the raw hex without quotes; this avoids dotenv interpolation/escaping.
POSTGRES_BOOTSTRAP_PASSWORD=
HOUFENG_RUNTIME_PASSWORD=
HOUFENG_MIGRATOR_PASSWORD=
HOUFENG_PLATFORM_ADMIN_PASSWORD=

# Initial Center administrator and stable browser-session signing key.
HOUFENG_INITIAL_USERNAME=
HOUFENG_INITIAL_PASSWORD=
HOUFENG_SESSION_HMAC_KEY=

# Recommended
# The release workflow fills the exact matching image tag. Keep it unchanged
# during installation; replace it only as part of a reviewed upgrade.
HOUFENG_IMAGE=

# Stable Compose resource prefix. Keep this value during upgrades and restores.
COMPOSE_PROJECT_NAME=houfeng

# Records is a production-profile compatibility marker. compose.yaml pins the
# running service to true because db-init converges the current Records ACL.
# Do not change it. Permanent deletion is intentionally unavailable in this
# profile until its external-witness contract is delivered.
HOUFENG_RECORDS_ENABLED=true
HOUFENG_PORTABILITY_ENABLED=true

# If forwarded client IPs are needed, set only the exact NPM-network CIDR.
# Never use 0.0.0.0/0 or ::/0.
HOUFENG_TRUSTED_PROXIES=
HOUFENG_SESSION_TTL=168h
HOUFENG_PASSWORD_BCRYPT_COST=10

# Local attachments are the production default and remain paired with the
# PostgreSQL recovery point below ./data. Scanner and processor safety limits
# are fixed inside compose.yaml and normally need no operator tuning.
HOUFENG_ATTACHMENT_BLOB_BACKEND=local

# Optional
# Telegram notifications. The binary currently accepts these only as ordinary
# environment values, so keep .env private and readable only by the operator.
HOUFENG_TELEGRAM_BOT_TOKEN=
HOUFENG_TELEGRAM_CHAT_ID=

# Comparison workbench. Put the key files in ./optional-secrets/comparison-keyring
# and set HOUFENG_COMPARISON_INTENT_KEYRING to the fixed in-container path
# /run/houfeng/optional-secrets/comparison-keyring. This directory is mounted
# only into Center, never the content processor.
HOUFENG_COMPARISON_ENABLED=false
HOUFENG_COMPARISON_INTENT_KEYRING=
HOUFENG_COMPARISON_INTENT_KEY_ID=
HOUFENG_COMPARISON_ADMISSION_BUDGET_BYTES=67108864

# Alternate S3 attachment storage. Local storage remains active unless the
# backend is explicitly changed to s3. Put both credential files below
# ./optional-secrets/s3 and use their in-container
# /run/houfeng/optional-secrets/s3/* paths; never place access-key values
# directly in this file. This directory is shared only by Center and processor.
HOUFENG_ATTACHMENT_S3_ENDPOINT=
HOUFENG_ATTACHMENT_S3_ACCESS_KEY_FILE=
HOUFENG_ATTACHMENT_S3_SECRET_KEY_FILE=
HOUFENG_ATTACHMENT_S3_BUCKET=
HOUFENG_ATTACHMENT_S3_SECURE=true
