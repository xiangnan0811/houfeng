# Copy to docs/deploy/compose.env before running Docker Compose.
# compose.yaml pulls linnea7171/houfeng:latest; it does not build locally.
# Replace every password before first boot.
# PostgreSQL data is stored under ./data/postgres/ by the root compose.yaml.

# PostgreSQL password used by both the db service and the center connection URL.
# Use URL-safe characters because compose.yaml interpolates this into postgres://...
POSTGRES_PASSWORD=replace-me-with-a-real-database-password

# Initial admin user seed. Used only when the users table is empty.
HOUFENG_INITIAL_USERNAME=admin
HOUFENG_INITIAL_PASSWORD=replace-me-with-a-real-admin-password

# Optional host port override. Default publishes Houfeng on 127.0.0.1:16001.
# HOUFENG_HOST_PORT=16001

# Optional for first login. Required before generating one-command agent install
# commands. Must be the externally reachable http(s) URL for browsers and agents,
# without query or fragment, for example https://center.example.com.
HOUFENG_PUBLIC_BASE_URL=
