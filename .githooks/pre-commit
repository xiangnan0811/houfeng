#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

case "$branch" in
  main|master)
    cat >&2 <<'EOF'
Commit blocked: local main/master is read-only for development work.

Create a feature branch first:
  git switch -c <type>/<short-description>

Use a non-main branch in the current checkout or a dedicated git worktree.
EOF
    exit 1
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "Commit blocked: Node.js is required for candidate verification." >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
# Keep the original cwd so relative GIT_INDEX_FILE retains its Git meaning.
exec node "$root/scripts/verify-candidate.mjs" --staged
