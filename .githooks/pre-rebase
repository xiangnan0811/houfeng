#!/bin/sh
set -eu

branch=${2:-}
if [ -z "$branch" ]; then
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
fi

case "$branch" in
  main|master|refs/heads/main|refs/heads/master)
    cat >&2 <<'EOF'
Rebase blocked: local main/master is read-only for development work.

Create or switch to a feature branch before rewriting development history.
Use a non-main branch in the current checkout or a dedicated git worktree.
EOF
    exit 1
    ;;
esac

exit 0
