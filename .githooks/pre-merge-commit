#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

case "$branch" in
  main|master)
    cat >&2 <<'EOF'
Merge blocked: local main/master is read-only for development work.

Merge feature work through a pull request instead of merging directly into local main/master.
Use a non-main branch in the current checkout or a dedicated git worktree.
EOF
    exit 1
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "Merge blocked: Node.js is required for candidate verification." >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
# Keep the original cwd so relative GIT_INDEX_FILE retains its Git meaning.
exec node "$root/scripts/verify-candidate.mjs" --staged
