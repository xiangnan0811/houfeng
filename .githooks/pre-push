#!/bin/sh
set -eu

if ! command -v node >/dev/null 2>&1; then
  echo "Push blocked: Node.js is required for candidate verification." >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
# The runner checks every protected remote ref before starting any gate.
# Do not read stdin here: Git's complete ref/OID list belongs to the runner.
exec node "$root/scripts/verify-candidate.mjs" --push
