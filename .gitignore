# docs
docs/superpowers/

# Raster screenshots / image artifacts are ignored by default.
# SVG is intentionally not ignored because the project may use SVG as source assets.
**/*.[Pp][Nn][Gg]
**/*.[Jj][Pp][Gg]
**/*.[Jj][Pp][Ee][Gg]
**/*.[Gg][Ii][Ff]
**/*.[Ww][Ee][Bb][Pp]
# Future explicitly approved public README/docs assets must live here.
!docs/public-assets/
!docs/public-assets/**/
!docs/public-assets/*.[Pp][Nn][Gg]
!docs/public-assets/*.[Jj][Pp][Gg]
!docs/public-assets/*.[Jj][Pp][Ee][Gg]
!docs/public-assets/*.[Gg][Ii][Ff]
!docs/public-assets/*.[Ww][Ee][Bb][Pp]
!docs/public-assets/**/*.[Pp][Nn][Gg]
!docs/public-assets/**/*.[Jj][Pp][Gg]
!docs/public-assets/**/*.[Jj][Pp][Ee][Gg]
!docs/public-assets/**/*.[Gg][Ii][Ff]
!docs/public-assets/**/*.[Ww][Ee][Bb][Pp]

# build outputs
/bin/
/dist/
