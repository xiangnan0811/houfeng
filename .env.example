# Local development example; replace these values before deployment.

# Center
HOUFENG_HTTP_ADDR=:8080
HOUFENG_WEB_DIST_DIR=web/dist
HOUFENG_DATABASE_URL=postgres://houfeng:houfeng@localhost:5432/houfeng?sslmode=disable
# Public URL reachable by target agents; used to generate one-command install commands.
HOUFENG_PUBLIC_BASE_URL=http://localhost:8080
HOUFENG_INCIDENT_SWEEP_INTERVAL=5s
# Optional center application log file. Leave empty for stdout-only local runs.
HOUFENG_LOG_FILE=

# Optional Telegram delivery. Leave both empty to disable outbound Telegram sends.
HOUFENG_TELEGRAM_BOT_TOKEN=
HOUFENG_TELEGRAM_CHAT_ID=

# Initial user seed (required on first startup; ignored once users table is non-empty).
HOUFENG_INITIAL_USERNAME=admin
HOUFENG_INITIAL_PASSWORD=replace-me-with-a-real-password
HOUFENG_INITIAL_DISPLAY_NAME=

# Session lifetime (rolling; refreshed on each authenticated request).
HOUFENG_SESSION_TTL=168h

# Records platform and comparison workbench. Both default off. Comparison
# requires HOUFENG_RECORDS_ENABLED=true and does not add a capability string.
HOUFENG_RECORDS_ENABLED=false
HOUFENG_COMPARISON_ENABLED=false
# Comparison HMAC keyring is a mounted 0400 directory. Both path and key id
# are required when HOUFENG_COMPARISON_ENABLED=true. Do not COPY key bytes
# into the image, and do not reuse session/deletion/backup key files.
HOUFENG_COMPARISON_INTENT_KEYRING=
HOUFENG_COMPARISON_INTENT_KEY_ID=
HOUFENG_COMPARISON_ADMISSION_BUDGET_BYTES=67108864

# Agent
HOUFENG_AGENT_SERVER_URL=http://localhost:8080
HOUFENG_AGENT_TOKEN_FILE=/etc/houfeng-agent/token
HOUFENG_AGENT_BUFFER_FILE=/var/lib/houfeng-agent/sync-buffer.json
HOUFENG_AGENT_BUFFER_MAX_ENTRIES=65536
HOUFENG_AGENT_BUFFER_MAX_AGE=72h
